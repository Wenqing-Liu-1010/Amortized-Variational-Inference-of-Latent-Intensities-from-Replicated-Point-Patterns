# Upload only the train/test implementation, required data/weights, and checks.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/requirements.txt
!/src/
/src/*
!/src/train.py
!/src/divvy.py
!/src/heldout.py
!/src/load_checkpoint.py
!/src/test_checkpoint.py
!/src/source/
/src/source/*
!/src/source/model.py
!/src/source/neural_process.py
!/src/source/mlp.py
!/scripts/
/scripts/*
!/scripts/synthetic.sh
!/scripts/divvy.sh
!/tests/
/tests/*
!/tests/test_model.py
!/tests/test_workflows.py
!/data/
/data/*
!/data/synthetic.pt
!/data/synthetic_test_64.pt
!/data/divvy/
/data/divvy/*
!/data/divvy/train.csv.gz
!/data/divvy/validation.csv.gz
!/data/divvy/test.csv.gz
!/checkpoints/
/checkpoints/*
!/checkpoints/synthetic.pt
!/checkpoints/divvy.pt
